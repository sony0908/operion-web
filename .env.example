# GEMINI_API_KEY: Requerida para el motor de análisis con contexto extenso de OPERION.
# Configurar en el panel de 'Secrets' en Google AI Studio.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL donde está alojado este servicio en Cloud Run.
APP_URL="MY_APP_URL"

# SUPABASE: Backend administrado (PostgreSQL 15, RLS y Auth)
# Obtener en https://supabase.com -> Project Settings -> API
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_ANON_KEY="tu-anon-key-publica"
# Clave administrativa para el servidor backend (nunca en Android ni frontend)
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key-secreta"

# GITHUB: Conector de solo lectura para repositorios
# Crear en GitHub -> Settings -> Developer Settings -> Personal Access Tokens -> Fine-grained tokens
# Permisos requeridos: Solo Lectura (Repository permissions -> Contents: Read-only, Metadata: Read-only)
GITHUB_TOKEN="ghp_o_tu_token_de_solo_lectura"

# NOTEBOOKLM / GOOGLE CLOUD (Opcional):
# Para cuentas Enterprise de Google Cloud / Vertex AI Search / Discovery Engine
GCP_PROJECT_ID="tu-gcp-project-id"

